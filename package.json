{
  "name": "dsh-migration-eval",
  "version": "1.1.0",
  "description": "双后端对比评测插件，用「批内对比」回答模型迁移的接受门问题 | Dual-backend comparison evaluation for DeepSeek Harness — a migration acceptance gate",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "suites",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "agent",
    "evaluation",
    "migration",
    "harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nmqcbl-cloud/dsh-assay.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:offline": "npm run build",
    "test:offline": "node test/run-offline.mjs",
    "prepublishOnly": "pnpm build && pnpm test:offline"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "js-yaml": "^5.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
